{
  "rules": {
    "emotionSpaces": {
      "$emotion": {
        "notes": {
          ".indexOn": ["timestamp"],
          ".read": "auth != null && auth.uid == 'OfC2v8DUfocJ6DYkJXv0JdzCKIy2'",
          "$id": {
            ".write": "auth != null && auth.uid == 'OfC2v8DUfocJ6DYkJXv0JdzCKIy2' && ($emotion == 'anxious' || $emotion == 'sad' || $emotion == 'lonely' || $emotion == 'tired' || $emotion == 'numb' || $emotion == 'calm')",
            ".validate": "newData.hasChildren(['text', 'timestamp'])",
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
            "timestamp": { ".validate": "newData.isNumber() && newData.val() <= now + 10000" },
            "encouragements": {
              "$choice": {
                ".write": "auth != null && auth.uid == 'OfC2v8DUfocJ6DYkJXv0JdzCKIy2' && data.parent().parent().child('text').exists()",
                ".validate": "($choice == 'c0' || $choice == 'c1' || $choice == 'c2') && newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
              }
            },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "users": {
      "$box": {
        ".read": "auth != null && auth.uid == 'OfC2v8DUfocJ6DYkJXv0JdzCKIy2'",
        ".indexOn": ["lastActive"],
        "$uid": {
          ".write": "auth != null && auth.uid == 'OfC2v8DUfocJ6DYkJXv0JdzCKIy2' && $uid.matches(/^user_[a-f0-9]{20}$/) && newData.exists()",
          ".validate": "newData.hasChildren(['state','lastActive']) && newData.child('lastActive').isNumber() && newData.child('state').hasChildren(['valence','arousal']) && newData.child('state').child('valence').isNumber() && newData.child('state').child('valence').val() >= 0 && newData.child('state').child('valence').val() <= 100 && newData.child('state').child('arousal').isNumber() && newData.child('state').child('arousal').val() >= 0 && newData.child('state').child('arousal').val() <= 100"
        }
      }
    },
    "messages": {
      ".read": "auth != null && auth.uid == 'OfC2v8DUfocJ6DYkJXv0JdzCKIy2'",
      ".indexOn": ["targetId"],
      "$id": {
        ".write": "auth != null && auth.uid == 'OfC2v8DUfocJ6DYkJXv0JdzCKIy2'",
        ".validate": "newData.hasChildren(['text','timestamp','targetId','voteCount']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 300 && newData.child('targetId').val() == 'wall' && newData.child('voteCount').isNumber() && newData.child('voteCount').val() >= 0"
      }
    },
    "history": { ".read": false, ".write": false },
    "feedback": {
      "$box": {
        ".read": "auth != null && auth.uid == 'OfC2v8DUfocJ6DYkJXv0JdzCKIy2'",
        "$id": {
          ".write": "auth != null && auth.uid == 'OfC2v8DUfocJ6DYkJXv0JdzCKIy2'",
          ".validate": "newData.hasChildren(['text','ts']) && newData.child('text').isString() && newData.child('text').val().length <= 600"
        }
      }
    },
    "talks": {
      "$box": {
        ".read": false,
        "$talk": {
          ".write": false,
          ".validate": "newData.hasChildren(['fromId','toId','status','createdAt'])",
          "wallMsgText": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "turns": { "$i": { "text": { ".validate": "newData.isString() && newData.val().length <= 400" } } }
        }
      }
    }
  }
}
